{
  "manifest_version": 2,
  "name": "Animation Pack Exporter for Mixamo",
  "description": "Save the Mixamo animations you choose into packs and download each pack as a ZIP.",
  "version": "1.3.1",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "https://www.mixamo.com/*",
    "https://mixamo.com/*",
    "https://mixamo-storage-prod.s3-us-west-2.amazonaws.com/*",
    "https://mixamo-storage-prod.s3.us-west-2.amazonaws.com/*"
  ],
  "optional_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.mixamo.com/*",
        "https://mixamo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.mixamo.com/*",
        "https://mixamo.com/*"
      ],
      "js": [
        "inject-xhr.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "web_accessible_resources": [
    "index.html",
    "xhr.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mixamo-batcher-for-firefox@joranomark.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent"
        ]
      }
    }
  }
}
